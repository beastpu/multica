{
  "schema_version": 1,
  "name": "产品需求研发",
  "roles": [
    {
      "key": "product_owner",
      "name": "产品负责人",
      "required": true,
      "allowed_actor_types": [
        "member"
      ]
    },
    {
      "key": "developer",
      "name": "开发执行者",
      "required": true,
      "allowed_actor_types": [
        "member",
        "agent",
        "squad"
      ]
    },
    {
      "key": "approver",
      "name": "验收人",
      "required": true,
      "allowed_actor_types": [
        "member"
      ]
    }
  ],
  "nodes": [
    {
      "key": "start",
      "kind": "start",
      "name": "开始"
    },
    {
      "key": "review",
      "kind": "activity",
      "name": "需求评审",
      "description": "确认需求范围、优先级和验收标准。",
      "owner_role": "product_owner",
      "executor": {
        "kind": "role",
        "role": "product_owner",
        "fallback": {
          "kind": "manual"
        }
      },
      "issue_policy": "fixed",
      "issue_templates": [
        {
          "key": "review_requirement",
          "title": "需求评审：{{host.title}}",
          "required": true,
          "initial_status": "todo"
        }
      ],
      "completion": {
        "mode": "automatic",
        "required_issue_outcome": "done",
        "handoff_required": true
      },
      "timeout_minutes": 1440,
      "outputs": [
        {
          "key": "accepted",
          "type": "bool",
          "required": true,
          "desc": "需求是否通过评审；不通过则不进入方案设计"
        },
        {
          "key": "scale",
          "type": "enum",
          "values": [
            "small",
            "medium",
            "large"
          ],
          "required": true,
          "desc": "工作量量级，决定方案设计要写到多细"
        }
      ]
    },
    {
      "key": "review_gate",
      "kind": "gateway",
      "name": "评审路由",
      "description": "评审未通过就地退回，通过才进入方案设计。",
      "cases": [
        {
          "id": "rejected",
          "label": "评审未通过",
          "when": "review.accepted == false"
        },
        {
          "id": "else",
          "label": "评审通过"
        }
      ]
    },
    {
      "key": "plan",
      "kind": "activity",
      "name": "方案设计",
      "description": "产出技术方案，由产品负责人确认后进入实施。",
      "owner_role": "product_owner",
      "executor": {
        "kind": "role",
        "role": "developer",
        "fallback": {
          "kind": "manual"
        }
      },
      "reviewer": {
        "kind": "role",
        "role": "product_owner",
        "required": true
      },
      "issue_policy": "fixed",
      "issue_templates": [
        {
          "key": "design_solution",
          "title": "方案设计：{{host.title}}",
          "required": true,
          "initial_status": "todo"
        }
      ],
      "completion": {
        "mode": "automatic",
        "required_issue_outcome": "done",
        "handoff_required": true
      },
      "artifacts": [
        {
          "key": "design_doc",
          "name": "技术方案",
          "description": "覆盖实现路径、影响范围与验证方式",
          "kind": "document",
          "required": true
        }
      ],
      "timeout_minutes": 1440,
      "outputs": [
        {
          "key": "breaking_change",
          "type": "bool",
          "required": true,
          "desc": "是否包含破坏性变更（接口、数据结构、配置）"
        }
      ]
    },
    {
      "key": "implement",
      "kind": "activity",
      "name": "代码实施",
      "description": "按方案实现，支持在节点内继续拆分子任务。",
      "owner_role": "developer",
      "executor": {
        "kind": "role",
        "role": "developer",
        "fallback": {
          "kind": "manual"
        }
      },
      "reviewer": {
        "kind": "role",
        "role": "approver",
        "required": true
      },
      "issue_policy": "fixed",
      "issue_templates": [
        {
          "key": "implement_solution",
          "title": "实现：{{host.title}}",
          "required": true,
          "initial_status": "todo"
        }
      ],
      "completion": {
        "mode": "automatic",
        "required_issue_outcome": "done",
        "handoff_required": true
      },
      "timeout_minutes": 1440,
      "artifacts": [
        {
          "key": "implementation_change",
          "name": "实施提交",
          "description": "本次实施对应的 MR / PR 或提交地址",
          "kind": "link",
          "required": true
        }
      ]
    },
    {
      "key": "end",
      "kind": "end",
      "name": "完成"
    },
    {
      "key": "rejected",
      "kind": "end",
      "name": "需求退回"
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "review"
    },
    {
      "from": "review",
      "to": "review_gate"
    },
    {
      "from": "review_gate",
      "to": "rejected",
      "from_case": "rejected"
    },
    {
      "from": "review_gate",
      "to": "plan",
      "from_case": "else"
    },
    {
      "from": "plan",
      "to": "implement"
    },
    {
      "from": "implement",
      "to": "end"
    }
  ],
  "acceptance": {}
}
