{
  "schema_version": 1,
  "name": "缺陷修复",
  "roles": [
    {
      "key": "qa",
      "name": "测试负责人",
      "required": true,
      "allowed_actor_types": [
        "member"
      ]
    },
    {
      "key": "fixer",
      "name": "修复执行者",
      "required": true,
      "allowed_actor_types": [
        "member",
        "agent",
        "squad"
      ]
    }
  ],
  "nodes": [
    {
      "key": "start",
      "kind": "start",
      "name": "开始"
    },
    {
      "key": "triage",
      "kind": "activity",
      "name": "问题分诊",
      "description": "确认缺陷可复现，明确影响范围和修复优先级。",
      "owner_role": "qa",
      "timeout_minutes": 1440,
      "executor": {
        "kind": "role",
        "role": "qa",
        "fallback": {
          "kind": "manual"
        }
      },
      "issue_policy": "fixed",
      "issue_templates": [
        {
          "key": "triage_bug",
          "title": "问题分诊：{{host.title}}",
          "required": true,
          "initial_status": "todo"
        }
      ],
      "completion": {
        "mode": "automatic",
        "required_issue_outcome": "done",
        "handoff_required": true
      },
      "outputs": [
        {
          "key": "is_bug",
          "type": "bool",
          "required": true,
          "desc": "确认这是缺陷，而不是预期行为、使用问题或重复单"
        },
        {
          "key": "severity",
          "type": "enum",
          "values": [
            "low",
            "medium",
            "high"
          ],
          "required": true,
          "desc": "影响面与紧急度：high 影响线上主流程，low 可择期处理"
        },
        {
          "key": "reproducible",
          "type": "bool",
          "desc": "是否按单据步骤稳定复现"
        }
      ]
    },
    {
      "key": "route",
      "kind": "gateway",
      "name": "分诊路由",
      "description": "不是缺陷就地关闭，是缺陷才进入根因分析。",
      "cases": [
        {
          "id": "not_a_bug",
          "label": "不是缺陷",
          "when": "triage.is_bug == false"
        },
        {
          "id": "else",
          "label": "确认缺陷"
        }
      ]
    },
    {
      "key": "root_cause",
      "kind": "activity",
      "name": "根因分析",
      "description": "定位缺陷的根本原因，说明触发条件与影响范围，作为修复的依据。",
      "owner_role": "fixer",
      "timeout_minutes": 1440,
      "executor": {
        "kind": "role",
        "role": "fixer",
        "fallback": {
          "kind": "manual"
        }
      },
      "issue_policy": "fixed",
      "issue_templates": [
        {
          "key": "analyze_root_cause",
          "title": "根因分析：{{host.title}}",
          "required": true,
          "initial_status": "todo"
        }
      ],
      "artifacts": [
        {
          "key": "root_cause_report",
          "name": "根因分析",
          "description": "根本原因、触发条件、影响范围与修复建议",
          "kind": "document",
          "required": true
        }
      ],
      "completion": {
        "mode": "automatic",
        "required_issue_outcome": "done",
        "handoff_required": true
      },
      "outputs": [
        {
          "key": "root_cause_found",
          "type": "bool",
          "required": true,
          "desc": "是否定位到根本原因；未定位时不要进入修复"
        },
        {
          "key": "component",
          "type": "string",
          "max_len": 120,
          "desc": "根因所在的模块 / 文件 / 服务"
        }
      ]
    },
    {
      "key": "fix",
      "kind": "activity",
      "name": "缺陷修复",
      "description": "定位根因并修复，由测试负责人验证修复效果后准出。",
      "owner_role": "fixer",
      "timeout_minutes": 1440,
      "executor": {
        "kind": "role",
        "role": "fixer",
        "fallback": {
          "kind": "manual"
        }
      },
      "reviewer": {
        "kind": "role",
        "role": "qa",
        "required": true
      },
      "issue_policy": "fixed",
      "issue_templates": [
        {
          "key": "fix_bug",
          "title": "修复：{{host.title}}",
          "required": true,
          "initial_status": "todo"
        }
      ],
      "completion": {
        "mode": "automatic",
        "required_issue_outcome": "done",
        "handoff_required": true
      },
      "artifacts": [
        {
          "key": "fix_change",
          "name": "修复提交",
          "description": "修复对应的 MR / PR 或提交地址",
          "kind": "link",
          "required": true
        }
      ]
    },
    {
      "key": "end",
      "kind": "end",
      "name": "完成"
    },
    {
      "key": "closed",
      "kind": "end",
      "name": "非缺陷关闭"
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "triage"
    },
    {
      "from": "triage",
      "to": "route"
    },
    {
      "from": "route",
      "to": "closed",
      "from_case": "not_a_bug"
    },
    {
      "from": "route",
      "to": "root_cause",
      "from_case": "else"
    },
    {
      "from": "root_cause",
      "to": "fix"
    },
    {
      "from": "fix",
      "to": "end"
    }
  ],
  "acceptance": {}
}
