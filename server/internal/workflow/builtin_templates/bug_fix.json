{
  "schema_version": 1,
  "name": "缺陷修复",
  "applies_to": {
    "kind": "issue"
  },
  "roles": [
    {
      "key": "qa",
      "name": "测试负责人",
      "required": true,
      "allowed_actor_types": [
        "member"
      ]
    },
    {
      "key": "fixer",
      "name": "修复执行者",
      "required": true,
      "allowed_actor_types": [
        "member",
        "agent",
        "squad"
      ]
    }
  ],
  "nodes": [
    {
      "key": "start",
      "kind": "start",
      "name": "开始"
    },
    {
      "key": "triage",
      "kind": "activity",
      "name": "问题分诊",
      "description": "确认缺陷可复现，明确影响范围和修复优先级。",
      "owner_role": "qa",
      "timeout_minutes": 1440,
      "executor": {
        "kind": "role",
        "role": "qa",
        "fallback": {
          "kind": "manual"
        }
      },
      "issue_policy": "fixed",
      "issue_templates": [
        {
          "key": "triage_bug",
          "title": "问题分诊：{{host.title}}",
          "required": true,
          "initial_status": "todo"
        }
      ],
      "completion": {
        "mode": "automatic",
        "required_issue_outcome": "done",
        "handoff_required": true
      }
    },
    {
      "key": "root_cause",
      "kind": "activity",
      "name": "根因分析",
      "description": "定位缺陷的根本原因，说明触发条件与影响范围，作为修复的依据。",
      "owner_role": "fixer",
      "timeout_minutes": 1440,
      "executor": {
        "kind": "role",
        "role": "fixer",
        "fallback": {
          "kind": "manual"
        }
      },
      "issue_policy": "fixed",
      "issue_templates": [
        {
          "key": "analyze_root_cause",
          "title": "根因分析：{{host.title}}",
          "required": true,
          "initial_status": "todo"
        }
      ],
      "artifacts": [
        {
          "key": "root_cause_report",
          "name": "根因分析",
          "description": "根本原因、触发条件、影响范围与修复建议",
          "kind": "document",
          "required": true
        }
      ],
      "completion": {
        "mode": "automatic",
        "required_issue_outcome": "done",
        "handoff_required": true
      }
    },
    {
      "key": "fix",
      "kind": "activity",
      "name": "缺陷修复",
      "description": "定位根因并修复，由测试负责人验证修复效果后准出。",
      "owner_role": "fixer",
      "timeout_minutes": 1440,
      "executor": {
        "kind": "role",
        "role": "fixer",
        "fallback": {
          "kind": "manual"
        }
      },
      "reviewer": {
        "kind": "role",
        "role": "qa",
        "required": true
      },
      "issue_policy": "fixed",
      "issue_templates": [
        {
          "key": "fix_bug",
          "title": "修复：{{host.title}}",
          "required": true,
          "initial_status": "todo"
        }
      ],
      "completion": {
        "mode": "automatic",
        "required_issue_outcome": "done",
        "handoff_required": true
      }
    },
    {
      "key": "end",
      "kind": "end",
      "name": "完成"
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "triage"
    },
    {
      "from": "triage",
      "to": "root_cause"
    },
    {
      "from": "root_cause",
      "to": "fix"
    },
    {
      "from": "fix",
      "to": "end"
    }
  ],
  "acceptance": {
    "policy": "member",
    "approver_role": "qa"
  }
}
